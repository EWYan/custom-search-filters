{
  "name": "custom-search-filters",
  "displayName": "custom-search-filters",
  "description": "Manage reusable include and exclude filters for VS Code file search",
  "icon": "media/icon.png",
  "publisher": "juzidaxia",
  "repository": {
    "type": "git",
    "url": "https://github.com/EWYan/custom-search-filters.git"
  },
  "version": "1.1.2",
  "engines": {
    "vscode": "^1.96.2"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "custom-search-filters.addFilter",
        "category": "Custom Search",
        "title": "Add Filter",
        "icon": "$(add)"
      },
      {
        "command": "custom-search-filters.selectAndSearch",
        "category": "Custom Search",
        "title": "Select Filter and Search",
        "icon": "$(filter)"
      },
      {
        "command": "custom-search-filters.deleteFilter",
        "category": "Custom Search",
        "title": "Delete Filter"
      },
      {
        "command": "custom-search-filters.addFolderToInclude",
        "category": "Custom Search",
        "title": "Include Folder..."
      },
      {
        "command": "custom-search-filters.addFolderToExclude",
        "category": "Custom Search",
        "title": "Exclude Folder..."
      },
      {
        "command": "custom-search-filters.editFilter",
        "category": "Custom Search",
        "title": "Edit Filter"
      },
      {
        "command": "custom-search-filters.recoverLegacyFilters",
        "category": "Custom Search",
        "title": "Recover Legacy Filters"
      },
      {
        "command": "custom-search-filters.addFileTypeToInclude",
        "category": "Custom Search",
        "title": "Include File Type..."
      },
      {
        "command": "custom-search-filters.addFileTypeToExclude",
        "category": "Custom Search",
        "title": "Exclude File Type..."
      },
      {
        "command": "custom-search-filters.showFilters",
        "category": "Custom Search",
        "title": "Show Filters Panel",
        "icon": "$(list-tree)"
      },
      {
        "command": "custom-search-filters.applySelectedFilters",
        "category": "Custom Search",
        "title": "Apply Selected Filters",
        "icon": "$(play)"
      },
      {
        "command": "custom-search-filters.clearFilterSelection",
        "category": "Custom Search",
        "title": "Clear Filter Selection",
        "icon": "$(clear-all)"
      },
      {
        "command": "custom-search-filters.refreshFilters",
        "category": "Custom Search",
        "title": "Refresh Filters",
        "icon": "$(refresh)"
      },
      {
        "command": "custom-search-filters.editPanelFilter",
        "category": "Custom Search",
        "title": "Edit Filter",
        "icon": "$(edit)"
      },
      {
        "command": "custom-search-filters.pinFilter",
        "category": "Custom Search",
        "title": "Pin Filter",
        "icon": "$(pin)"
      },
      {
        "command": "custom-search-filters.unpinFilter",
        "category": "Custom Search",
        "title": "Unpin Filter",
        "icon": "$(pinned)"
      }
    ],
    "submenus": [
      {
        "id": "custom-search-filters.explorerSubmenu",
        "label": "Search Filters"
      }
    ],
    "configuration": {
      "title": "Custom Search Filters",
      "properties": {
        "custom-search-filters.globalFilters": {
          "type": "array",
          "default": [],
          "description": "Global search filters that are available across all projects. These filters can be synced via VS Code Settings Sync. Only user settings are used; workspace values are ignored.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "include",
              "exclude"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Filter name"
              },
              "include": {
                "type": "string",
                "description": "Glob pattern for files to include"
              },
              "exclude": {
                "type": "string",
                "description": "Glob pattern for files to exclude"
              },
              "scope": {
                "type": "string",
                "enum": [
                  "global"
                ],
                "default": "global",
                "description": "Filter scope for global settings"
              }
            }
          }
        },
        "custom-search-filters.globalFiltersEnabled": {
          "type": "object",
          "default": {},
          "description": "Enable/disable global filters. Each filter name maps to a boolean value indicating if it's enabled. All global filters are automatically added here when created, and removed when deleted. Filters are enabled (true) by default. Only user settings are used; workspace values are ignored.",
          "additionalProperties": {
            "type": "boolean"
          }
        }
      }
    },
    "colors": [
      {
        "id": "customSearchFilters.pinnedForeground",
        "description": "Color of pinned filters in the Search Filters panel.",
        "defaults": {
          "dark": "charts.yellow",
          "light": "charts.orange",
          "highContrast": "charts.yellow",
          "highContrastLight": "charts.orange"
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "custom-search-filters.addFolderToInclude",
          "when": "false"
        },
        {
          "command": "custom-search-filters.addFolderToExclude",
          "when": "false"
        },
        {
          "command": "custom-search-filters.addFileTypeToInclude",
          "when": "false"
        },
        {
          "command": "custom-search-filters.addFileTypeToExclude",
          "when": "false"
        },
        {
          "command": "custom-search-filters.editPanelFilter",
          "when": "false"
        },
        {
          "command": "custom-search-filters.pinFilter",
          "when": "false"
        },
        {
          "command": "custom-search-filters.unpinFilter",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "custom-search-filters.selectAndSearch",
          "when": "view == workbench.view.search",
          "group": "navigation"
        },
        {
          "command": "custom-search-filters.applySelectedFilters",
          "when": "view == custom-search-filters.filters",
          "group": "navigation@1"
        },
        {
          "command": "custom-search-filters.clearFilterSelection",
          "when": "view == custom-search-filters.filters",
          "group": "navigation@2"
        },
        {
          "command": "custom-search-filters.addFilter",
          "when": "view == custom-search-filters.filters",
          "group": "navigation@3"
        },
        {
          "command": "custom-search-filters.refreshFilters",
          "when": "view == custom-search-filters.filters",
          "group": "navigation@4"
        },
        {
          "command": "custom-search-filters.showFilters",
          "when": "view == workbench.view.search",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "command": "custom-search-filters.selectAndSearch",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "submenu": "custom-search-filters.explorerSubmenu",
          "when": "explorerResourceIsFolder || resourceExtname != ''",
          "group": "4_search@10"
        }
      ],
      "custom-search-filters.explorerSubmenu": [
        {
          "command": "custom-search-filters.addFolderToInclude",
          "when": "explorerResourceIsFolder",
          "group": "1_folder@1"
        },
        {
          "command": "custom-search-filters.addFolderToExclude",
          "when": "explorerResourceIsFolder",
          "group": "1_folder@2"
        },
        {
          "command": "custom-search-filters.addFileTypeToInclude",
          "when": "resourceExtname != '' && !explorerResourceIsFolder",
          "group": "2_fileType@1"
        },
        {
          "command": "custom-search-filters.addFileTypeToExclude",
          "when": "resourceExtname != '' && !explorerResourceIsFolder",
          "group": "2_fileType@2"
        }
      ],
      "view/item/context": [
        {
          "command": "custom-search-filters.pinFilter",
          "when": "view == custom-search-filters.filters && (viewItem == searchFilter || viewItem == searchFilter.builtin)",
          "group": "inline@1"
        },
        {
          "command": "custom-search-filters.unpinFilter",
          "when": "view == custom-search-filters.filters && (viewItem == searchFilter.pinned || viewItem == searchFilter.builtin.pinned)",
          "group": "inline@1"
        },
        {
          "command": "custom-search-filters.editPanelFilter",
          "when": "view == custom-search-filters.filters && (viewItem == searchFilter || viewItem == searchFilter.pinned)",
          "group": "inline@2"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "custom-search-filters",
          "title": "Search Filters",
          "icon": "media/filter.svg"
        }
      ]
    },
    "views": {
      "custom-search-filters": [
        {
          "id": "custom-search-filters.filters",
          "name": "Filters",
          "visibility": "visible"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.96.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1"
  }
}
